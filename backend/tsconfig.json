{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "lib": ["ES2022"],
        "outDir": "dist",
        "rootDir": "src",
        "strict": true,
        "skipLibCheck":true,
        "esModuleInterop": true,
        "resolveJsonModule": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "ignoreDeprecations": "6.0",
        "paths": {
            "@shared/*": ["../shared/*"]
        }
    },
    "include": ["src", "scripts"],
    "exclude": ["node_modules", "dist"]
}