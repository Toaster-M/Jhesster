// Jhesster Chess – Prisma Schema
// Run: npx prisma migrate dev --name init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  username     String   @unique
  email        String   @unique
  passwordHash String
  rating       Int      @default(1200)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  gamesAsWhite Game[]     @relation("WhitePlayer")
  gamesAsBlack Game[]     @relation("BlackPlayer")
  stats        GameStats?

  @@map("users")
}

model Game {
  id        String      @id @default(uuid())
  whiteId   String
  blackId   String?     // null = vs AI
  result    GameResult?
  pgn       String?     // full PGN string
  fen       String?     // final position FEN
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  white User    @relation("WhitePlayer", fields: [whiteId], references: [id], onDelete: Cascade)
  black User?   @relation("BlackPlayer", fields: [blackId], references: [id], onDelete: SetNull)
  moves Move[]

  @@map("games")
}

model Move {
  id         String   @id @default(uuid())
  gameId     String
  moveNumber Int
  color      String   // 'w' | 'b'
  from       String
  to         String
  san        String   // standard algebraic notation
  fen        String   // position after this move
  timestamp  DateTime @default(now())

  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@index([gameId, moveNumber])
  @@map("moves")
}

model GameStats {
  id            String   @id @default(uuid())
  userId        String   @unique
  wins          Int      @default(0)
  losses        Int      @default(0)
  draws         Int      @default(0)
  winStreak     Int      @default(0)
  bestRating    Int      @default(1200)
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("game_stats")
}

enum GameResult {
  WHITE_WINS
  BLACK_WINS
  DRAW
  ABANDONED
}
